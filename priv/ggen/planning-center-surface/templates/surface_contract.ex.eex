<%
  probe_lines =
    probe_kinds
    |> Enum.sort_by(& &1["kind"])
    |> Enum.map_join(",\n", fn row ->
      kind = to_string(row["kind"])
      role = to_string(row["aria_role"])
      role_spec = to_string(row["role_spec"])
      purpose = to_string(row["semantic_purpose"])

      "    #{inspect(kind)} => %{role: #{inspect(role)}, role_spec: #{inspect(role_spec)}, purpose: #{inspect(purpose)}}"
    end)
%># GENERATED by `mix ash_planning_center.generate_surface`.
# Source: priv/ggen/planning-center-surface/ontology.ttl.
# Do not edit by hand; change the ontology/SPARQL/template and re-manufacture.

defmodule <%= module_name %> do
  @moduledoc "Ontology-manufactured accessibility surface contract for Planning Center and Church Center."

  @spec_version <%= inspect(to_string(spec_version)) %>
  @surface_runtime <%= inspect(to_string(surface_runtime)) %>
  @observer <%= inspect(to_string(observer)) %>
  @planner_boundary <%= inspect(to_string(planner_boundary)) %>
  @planning_formalism <%= inspect(to_string(planning_formalism)) %>
  @authority_boundary <%= inspect(to_string(authority_boundary)) %>

  @probe_kinds %{
<%= probe_lines %>
  }

  @spec metadata() :: map()
  def metadata do
    %{
      "specVersion" => @spec_version,
      "surfaceRuntime" => @surface_runtime,
      "observer" => @observer,
      "plannerBoundary" => @planner_boundary,
      "planningFormalism" => @planning_formalism,
      "authorityBoundary" => @authority_boundary
    }
  end

  @spec probe(String.t() | atom(), String.t(), String.t(), keyword()) :: map()
  def probe(kind, id, accessible_name, opts \\ [])
      when is_binary(id) and is_binary(accessible_name) do
    kind = to_string(kind)
    spec = Map.fetch!(@probe_kinds, kind)

    %{
      "id" => id,
      "role" => spec.role,
      "name" => accessible_name,
      "exact" => Keyword.get(opts, :exact, true),
      "roleSpec" => spec.role_spec,
      "semanticPurpose" => spec.purpose,
      "denotes" => Keyword.get(opts, :denotes),
      "capabilityId" => Keyword.get(opts, :capability_id),
      "authorityBoundary" => @authority_boundary,
      "surfaceRuntime" => @surface_runtime,
      "observer" => @observer,
      "plannerBoundary" => @planner_boundary,
      "planningFormalism" => @planning_formalism
    }
  end

  @spec probe_kinds() :: map()
  def probe_kinds, do: @probe_kinds
end
